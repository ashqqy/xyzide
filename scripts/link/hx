#!/usr/bin/env bash

# named "hx" so zellij passes the clicked path as FILE:LINE

# shrink our floating pane into the corner, like Alt+y's
zellij action change-floating-pane-coordinates -p "terminal_$ZELLIJ_PANE_ID" \
  -x 0 -y 0 --width 1 --height 1 -b true 2>/dev/null

ARG="$1"
FILE="$ARG"
LINE=""
if [ ! -e "$ARG" ] && [[ "$ARG" =~ ^(.+):([0-9]+)$ ]]; then
  FILE="${BASH_REMATCH[1]}"
  LINE="${BASH_REMATCH[2]}"
fi

exec "$XYZ_OPENER" --stay "$FILE" $LINE
